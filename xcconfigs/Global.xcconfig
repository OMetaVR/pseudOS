DEVELOPMENT_TEAM[config=Debug] = AAAAA11111
DEVELOPMENT_TEAM[config=Release] = AAAAA11111

DEVELOPMENT_TEAM_SUFFIX[config=Debug] = .$(DEVELOPMENT_TEAM)
DEVELOPMENT_TEAM_SUFFIX[config=Release] =

APP_GROUP_SIDESTORE = group.com.SideStore.SideStore$(DEVELOPMENT_TEAM_SUFFIX)
APP_GROUP_ALTSTORE = group.com.rileytestut.AltStore$(DEVELOPMENT_TEAM_SUFFIX)
LIVECONTAINER_BUNDLE_IDENTIFIER = com.kdt.livecontainer$(DEVELOPMENT_TEAM_SUFFIX)
// FORK: identity is a build setting so pseudOS can also build as a side-by-side dev app (see FORK.md)
PSEUDOS_IDENTITY_BASE = com.kdt.livecontainer
PSEUDOS_URL_SCHEME = livecontainer
